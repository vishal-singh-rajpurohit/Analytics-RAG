# ==============================================================================
# Syntropic Analytics Platform — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Server IP Configuration
# ------------------------------------------------------------------------------
DOMAIN=analytics.vishalsingh.me
PUBLIC_IP=16.176.226.219

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 17 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=customer_care_db
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5431/customer_care_db

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Cache & Task Broker)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. AI / LLM Configuration
# ------------------------------------------------------------------------------
# Provider options: 'google' (default) | 'openai'
LLM_PROVIDER=google

# Google Gemini via langchain-google-genai (Get key: https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Backend API & Internal URLs
# ------------------------------------------------------------------------------
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
NEXT_PUBLIC_API_URL=https://analytics.vishalsingh.me/api/v1
NEXT_PUBLIC_API_URL_VERSION=v1

# ------------------------------------------------------------------------------
# 6. Authentication & JWT Security Tokens
# ------------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=kldhfjkjhsdKSJDF768ajdfJJKHTRTCGHNB8767bKASDKFHhkjhh87879879
REFRESH_TOKEN_SECRET=kldhfjkjhsdKSJasdfwer23NB8767bKASDKFHhkjhh87879879324fasvaSSF

# NextAuth Configuration
NEXTAUTH_URL=https://analytics.vishalsingh.me
NEXTAUTH_SECRET=supersecretnextauthkey123456789

# ------------------------------------------------------------------------------
# 7. File Storage Directory
# ------------------------------------------------------------------------------
UPLOAD_DIR=app/uploads

# ------------------------------------------------------------------------------
# 8. CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=["https://analytics.vishalsingh.me","http://analytics.vishalsingh.me","http://16.176.226.219","http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 9. Google OAuth Credentials (Login / Social Auth)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
